# Copy this file to .env and fill in your values
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string

# Initial user credentials (used only on first startup if DB is empty)
ADMIN_EMAIL=admin@regencare.in
ADMIN_PASSWORD=change-this
VIEWER_EMAIL=team@ntglobal.net
VIEWER_PASSWORD=change-this
